          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Nav Group",
              "model": "nav-group",
              "filter": "nav-group"
            }
          }
        }
      }
    },
    {
      "title": "Nav Group Item",
      "id": "nav-group-item",
      "plugins": {
        "xwalk": {
          "page": {
